{
  "name": "ytdbns-monthly-intelligence",
  "version": "5.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "postinstall": "node scripts/postinstall-gate.mjs",
    "check:mobile:static": "node scripts/mobile-responsive-static-check.mjs",
    "check:mobile": "node scripts/mobile-responsive-acceptance.mjs",
    "check:v5:mobile:static": "node scripts/v5-native-mobile-static-check.mjs",
    "check:v5:mobile": "node scripts/v5-native-mobile-acceptance.mjs",
    "check:v5:browser": "node scripts/v5-browser-acceptance.mjs",
    "check:ui:static": "node scripts/ui-integrity-static-check.mjs",
    "check:operation-log": "node scripts/operation-log-static-check.mjs",
    "check:import-report-compat": "node scripts/import-report-compat-check.mjs",
    "check:multi-file-import": "node scripts/multi-file-import-check.mjs",
    "check:master-data-import-period": "node scripts/master-data-import-period-check.mjs",
    "check:release:static": "npm run check:v5:mobile:static && npm run check:ui:static && npm run check:operation-log && npm run check:import-report-compat && npm run check:multi-file-import && npm run check:master-data-import-period && npm run check:core-report-model",
    "db:create": "wrangler d1 create ytdbns-monthly-db",
    "db:migrate:local": "wrangler d1 migrations apply ytdbns-monthly-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply ytdbns-monthly-db --remote",
    "r2:create": "wrangler r2 bucket create ytdbns-monthly-raw-reports",
    "check:core-report-model": "node scripts/core-report-model-check.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.62.1",
    "wrangler": "^4.0.0"
  }
}
